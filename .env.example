# Environment Configuration
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# Supabase Configuration (Optional - embedded mock/local persistence enabled when unset)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder
SUPABASE_STORAGE_BUCKET=resumes

# AI Configuration (Gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-placeholder
GEMINI_MODEL=gemini-1.5-flash
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_RETRIES=3

# Security & Upload Limits
JWT_SECRET=avengercoders-secret-key-change-in-production-min32chars
MAX_UPLOAD_SIZE_MB=10
MAX_FILES_PER_BATCH=10

# Real-World Job Discovery Providers (Optional API Keys - Open web feeds & fallback search enabled by default)
# 1. Adzuna API (https://developer.adzuna.com/)
ADZUNA_APP_ID=your-adzuna-app-id-placeholder
ADZUNA_API_KEY=your-adzuna-api-key-placeholder
ADZUNA_COUNTRY=us

# 2. JSearch via RapidAPI (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
RAPIDAPI_KEY=your-rapidapi-key-placeholder
JSEARCH_API_HOST=jsearch.p.rapidapi.com
JOB_SEARCH_TIMEOUT_MS=10000

# Recruiter Candidate Discovery Providers (Optional)
# 1. GitHub Public Talent (Uses public GitHub Search API for users with hireable:true; personal access token optional for higher rate limits)
GITHUB_TOKEN=your-github-token-placeholder
# 2. Open Talent Network / Authorized Candidate API (Optional external endpoint)
OPEN_TALENT_API_URL=https://api.opentalent.example.com
OPEN_TALENT_API_KEY=your-open-talent-api-key-placeholder
CANDIDATE_SEARCH_TIMEOUT_MS=10000

